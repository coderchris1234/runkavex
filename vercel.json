{
    "version": 2,
    "framework": null,
    "installCommand": "cd Runkavex && npm install",
    "buildCommand": "cd Runkavex && npm run build",
    "outputDirectory": "Runkavex/public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "maxDuration": 30,
            "excludeFiles": "{tests/**,database/factories/**,database/seeders/**,node_modules/**,public/build/**,public/theme/**,public/temp/**}"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/Runkavex/public/build/$1"
        },
        {
            "src": "/theme/(.*)",
            "dest": "/Runkavex/public/theme/$1"
        },
        {
            "src": "/brand/(.*)",
            "dest": "/Runkavex/public/brand/$1"
        },
        {
            "src": "/js/(.*)",
            "dest": "/Runkavex/public/js/$1"
        },
        {
            "src": "/(favicon\\.ico|robots\\.txt)",
            "dest": "/Runkavex/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_NAME": "Runkavex Capital",
        "APP_ENV": "production",
        "APP_KEY": "base64:2KJBZjZVfg4ZjiD+hWuDt4C2TeIWz7wzN3XQc3SAzLM=",
        "APP_DEBUG": "true",
        "APP_URL": "https://runkavex-runkavex-five.vercel.app",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "error",
        "DB_CONNECTION": "sqlite",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "QUEUE_CONNECTION": "sync",
        "FILESYSTEM_DISK": "local",
        "BROADCAST_CONNECTION": "log"
    }
}
